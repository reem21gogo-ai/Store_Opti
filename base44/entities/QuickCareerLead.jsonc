{
  "name": "QuickCareerLead",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "age_range": {
      "type": "string",
      "enum": [
        "under_18",
        "18_24",
        "25_34",
        "35_44",
        "45_54",
        "55_plus"
      ]
    },
    "contact": {
      "type": "string"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "email",
        "mobile"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ]
    },
    "strongest_interest": {
      "type": "string"
    },
    "top_interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "holland_code": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "default": "quick_career"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "converted",
        "closed"
      ],
      "default": "new"
    },
    "user_email": {
      "type": "string"
    }
  },
  "required": [
    "contact"
  ]
}